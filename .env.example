# Frontend demo berjalan tanpa konfigurasi dan tanpa API key.
# Integrasi RunPod belum membuat resource. Jangan masukkan rahasia ke NEXT_PUBLIC_*.
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_STUDIO_SERVICE=demo

# Opsional untuk kontrol cloud backend. Buat key Restricted khusus proyek.
# Gunakan GraphQL Read only / api.runpod.ai None selama operasi tulis belum diaktifkan.
RUNPOD_API_KEY=
RUNPOD_API_BASE_URL=https://api.runpod.io/v2
RUNPOD_WORKER_IMAGE=ghcr.io/muhira007/voxcpm-studio-worker@sha256:763938c78e0d1be4ccb968ab6dd7a351b6a14be5b7f8001e7c04540df7df6071

# Pengaman kontrol Pod. Biarkan false sampai saldo, volume, data center, izin key,
# dan pengawas cloud siap untuk satu pengujian berbayar terkontrol.
RUNPOD_WRITE_ENABLED=false
RUNPOD_CLOUD=SECURE
RUNPOD_DATA_CENTER_ID=
RUNPOD_NETWORK_VOLUME_ID=
RUNPOD_HARD_COST_LIMIT_USD=1.00
RUNPOD_MAX_SESSION_MINUTES=240

# Rencana siklus GPU pertama yang diperiksa oleh `npm run runpod:preflight`.
# Preflight hanya memakai request GET dan tidak pernah memanggil gateway mutation.
RUNPOD_PREFLIGHT_PROFILE_ID=3090
RUNPOD_PREFLIGHT_DURATION_MINUTES=30
RUNPOD_PREFLIGHT_MAX_HOURLY_RATE=0.80

# Attestation operasional. Biarkan false sampai buktinya benar-benar tersedia.
# Controller menolak start, perpanjangan, dan job baru jika salah satu masih false.
# Stop darurat tetap tersedia selama write gateway dan API key valid.
RUNPOD_WRITE_SCOPE_CONFIRMED=false
RUNPOD_BALANCE_CONFIRMED=false
RUNPOD_SINGLE_REPLICA_CONFIRMED=false
RUNPOD_PERSISTENT_STATE_CONFIRMED=false
RUNPOD_WATCHDOG_DEPLOYED=false
RUNPOD_STOP_ALERT_CONFIGURED=false

# API lokal: buat seluruh nilai rahasia berbeda sebelum menjalankannya.
# Jangan pernah memakai awalan NEXT_PUBLIC_ untuk rahasia ini.
STUDIO_API_KEY=replace-with-at-least-32-random-characters
STUDIO_ACCESS_PASSWORD=replace-with-at-least-12-private-characters
STUDIO_SESSION_SECRET=replace-with-a-different-32-character-secret
WORKER_URL=http://127.0.0.1:8001
WORKER_API_KEY=replace-with-a-different-32-character-secret
# Aplikasi dan command `npm run runpod:watchdog` harus memakai direktori persisten
# yang sama. Gunakan satu replica selama state masih berbasis filesystem.
VOXCPM_DATA_DIR=.data
