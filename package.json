{
  "name": "voxcpm-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:worker": "python -m pytest worker/tests -q",
    "test:all": "npm test && npm run test:worker",
    "worker:start": "python worker/start.py",
    "runpod:watchdog": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/runpod-watchdog.ts",
    "format": "prettier --write src tests *.json *.mjs *.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
